# Configuration summary printed at the end of configure. Include last.

function(_diffpick_summary label value)
    string(LENGTH "${label}" _length)
    math(EXPR _pad "22 - ${_length}")
    if(_pad LESS 1)
        set(_pad 1)
    endif()
    string(REPEAT " " ${_pad} _spaces)
    message(STATUS "  ${label}${_spaces}${value}")
endfunction()

function(_diffpick_summary_option variable)
    if(${variable})
        _diffpick_summary("${variable}" "ON")
    else()
        _diffpick_summary("${variable}" "OFF")
    endif()
endfunction()

message(STATUS "==================== ${PROJECT_NAME} ${PROJECT_VERSION} ====================")
_diffpick_summary("Build type" "${CMAKE_BUILD_TYPE}${CMAKE_CONFIGURATION_TYPES}")
_diffpick_summary("Generator" "${CMAKE_GENERATOR}")
_diffpick_summary("Source dir" "${PROJECT_SOURCE_DIR}")
_diffpick_summary("Binary dir" "${PROJECT_BINARY_DIR}")
_diffpick_summary("Compiler" "${CMAKE_CXX_COMPILER_ID} ${CMAKE_CXX_COMPILER_VERSION}")
_diffpick_summary("Compiler path" "${CMAKE_CXX_COMPILER}")
_diffpick_summary("C++ standard" "at least C++17 (more if Qt requires it), extensions ${CMAKE_CXX_EXTENSIONS}")
if(CMAKE_CXX_COMPILER_LAUNCHER)
    _diffpick_summary("Compiler launcher" "${CMAKE_CXX_COMPILER_LAUNCHER}")
else()
    _diffpick_summary("Compiler launcher" "none")
endif()
_diffpick_summary("Qt" "${Qt6_VERSION} (${Qt6_DIR})")
_diffpick_summary_option(DIFFPICK_WARNINGS_AS_ERRORS)
_diffpick_summary_option(DIFFPICK_COMPILER_CACHE)
_diffpick_summary_option(BUILD_TESTING)
message(STATUS "======================================================")
