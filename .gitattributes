# Default to LF for all text files: the shell scripts run in WSL and CI.
* text=auto eol=lf

*.cpp text eol=lf
*.hpp text eol=lf
*.in  text eol=lf
*.cmake text eol=lf
*.txt text eol=lf
*.md  text eol=lf
*.sh  text eol=lf

*.ps1 text eol=lf
*.rc  text eol=lf

# Binary files
*.ico binary
*.png binary
