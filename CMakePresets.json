{
	"version": 3,
	"cmakeMinimumRequired": { "major": 3, "minor": 22, "patch": 0 },
	"configurePresets": [
		{
			"name": "release-base",
			"hidden": true,
			"generator": "Ninja",
			"binaryDir": "${sourceDir}/build-${hostSystemName}",
			"cacheVariables": { "CMAKE_BUILD_TYPE": "Release" }
		},
		{
			"name": "windows-release",
			"displayName": "Windows Release (Ninja)",
			"inherits": "release-base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Windows"
			}
		},
		{
			"name": "linux-release",
			"displayName": "Linux Release (Ninja, including WSL)",
			"inherits": "release-base",
			"condition": {
				"type": "equals",
				"lhs": "${hostSystemName}",
				"rhs": "Linux"
			}
		}
	]
}
